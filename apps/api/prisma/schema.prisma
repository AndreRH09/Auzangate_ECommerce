// Modelo de datos de AUZANGATE (plan de stack §4.4 + deltas de REQUISITOS-FUNCIONALES §4).
// Precios siempre en céntimos (Int). Moneda PEN.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum Locale {
  es
  en
}

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  NEEDS_REVIEW
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ───────── Usuarios ─────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  locale       Locale     @default(es)
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  addresses      Address[]
  cart           Cart?
  orders         Order[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  line1      String
  reference  String?
  district   String
  province   String
  department String
  phone      String
  isDefault  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────── Catálogo ─────────

model Category {
  id       String  @id @default(cuid())
  parentId String?
  sort     Int     @default(0)

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     Product[]
}

model CategoryTranslation {
  categoryId String
  locale     Locale
  name       String
  slug       String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@unique([locale, slug])
}

model Series {
  id   String @id @default(cuid())
  code String @unique // CARAL | WARI | SICAN | VICUS | NASCA
  sort Int    @default(0)

  translations SeriesTranslation[]
  products     Product[]
}

model SeriesTranslation {
  seriesId    String
  locale      Locale
  name        String
  slug        String
  description String @db.Text

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([seriesId, locale])
  @@unique([locale, slug])
}

model Product {
  id         String        @id @default(cuid())
  code       String        @unique @db.VarChar(12) // AC01 / FAW01: [F si es mujer] A + inicial de serie + nº
  categoryId String
  seriesId   String?
  status     ProductStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt // alimenta lastModified del sitemap

  category     Category             @relation(fields: [categoryId], references: [id])
  series       Series?              @relation(fields: [seriesId], references: [id])
  translations ProductTranslation[]
  variants     ProductVariant[]
  images       ProductImage[]

  @@index([status])
}

model ProductTranslation {
  productId   String
  locale      Locale
  name        String
  slug        String
  subtitle    String // dato técnico: "Pluma 650 · -10 °C"
  description String @db.Text
  techSpecs   Json // pares clave/valor de la ficha técnica (se muestran en mono)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
  @@unique([locale, slug])
  // ponytail: índice FULLTEXT para la búsqueda se agrega en F1 junto con /search
}

model ProductVariant {
  id         String @id @default(cuid())
  productId  String
  sku        String @unique
  colorHex   String @db.Char(7)
  colorName  Json // { "es": "Granito", "en": "Granite" }
  size       String
  priceCents Int
  stock      Int    @default(0)
  lowStockAt Int    @default(3)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, colorHex, size])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  r2Key     String
  colorHex  String? @db.Char(7) // color de la variante que muestra; null = sirve para todos
  altEs     String
  altEn     String
  width     Int
  height    Int
  sort      Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ───────── Bolsa y órdenes ─────────

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  sessionId String?  @unique // bolsa de invitado; se fusiona al iniciar sesión
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  qty       Int

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique // AUZ-000123
  userId          String
  email           String
  status          OrderStatus @default(PENDING_PAYMENT)
  currency        String      @default("PEN") @db.Char(3)
  subtotalCents   Int
  shippingCents   Int
  totalCents      Int
  shippingAddress Json // snapshot: si el cliente edita su dirección, la orden no cambia
  trackingCode    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User         @relation(fields: [userId], references: [id])
  items    OrderItem[]
  events   OrderEvent[]
  payments Payment[]

  @@index([userId])
  @@index([status, createdAt])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  variantId      String
  qty            Int
  unitPriceCents Int
  nameSnapshot   String
  skuSnapshot    String

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  actorId   String? // null = sistema (webhook, cron)
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  provider    String // stripe | mercadopago | culqi
  providerRef String        @unique // idempotencia del webhook
  status      PaymentStatus
  rawEvent    Json
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ───────── Configuración y marketing ─────────

model ShippingZone {
  id            String @id @default(cuid())
  name          String
  regions       Json // departamentos incluidos: ["Lima", "Callao"]
  priceCents    Int
  freeOverCents Int?
  sort          Int    @default(0)
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    Locale
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  entity    String
  entityId  String
  action    String
  diff      Json
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
