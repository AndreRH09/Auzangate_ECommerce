# DESARROLLO LOCAL. Copia a .env (Compose y la API lo leen solos). .env nunca se sube a git.

MYSQL_ROOT_PASSWORD=cambia-esto
MYSQL_DATABASE=auzangate
MYSQL_PORT=3306
ADMINER_PORT=8080

# ponytail: root solo en dev (prisma migrate dev necesita crear la shadow DB).
# La API corre en Windows, por eso el host es localhost.
DATABASE_URL=mysql://root:cambia-esto@localhost:3306/auzangate

# Admin inicial que crea `pnpm db:seed` (contraseña mín. 10 caracteres)
SEED_ADMIN_EMAIL=admin@auzangate.local
SEED_ADMIN_PASSWORD=cambia-esto-tambien

# Firma de tokens de sesión (mín. 32 caracteres):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-32-caracteres-aleatorios
